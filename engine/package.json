{
  "name": "unmeta-engine",
  "version": "1.0.0",
  "dependencies": {
    "pako": "^2.2.0"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "esbuild": "^0.24.2",
    "typescript": "~7.0.2",
    "@types/node": "^22.10.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
